# =============================================================================
# Railway ↔ Kubernetes env mapping (SPORT / 4VELO)
# =============================================================================
# Copy sections into Railway Dashboard → Service → Variables.
# For K8s: split into app-configmap.yaml (non-secret) and app-secrets (secret).
# NEVER commit filled secrets. See docs/operations/RAILWAY_KUBERNETES.md
# =============================================================================

# -----------------------------------------------------------------------------
# [backend]  ↔  sport-backend-api  +  sport-app-config / sport-app-secrets
# -----------------------------------------------------------------------------
# Railway auto (reference from plugins):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}

SECRET_KEY=                          # → Secret SECRET_KEY
DEBUG=0                              # → ConfigMap DEBUG
ALLOWED_HOSTS=                       # → ConfigMap ALLOWED_HOSTS
CORS_ALLOWED_ORIGINS=                # → ConfigMap CORS_ALLOWED_ORIGINS (if set in Django)
PORT=8000                            # → ConfigMap PORT

# Celery (backend may enqueue; workers consume)
CELERY_BROKER_URL=                   # Railway: same as REDIS_URL → ConfigMap
CELERY_RESULT_BACKEND=               # often redis://.../1 → ConfigMap

BROUTER_URL=http://brouter.railway.internal:17777/brouter
# K8s equivalent: http://sport-brouter:17777/brouter → ConfigMap BROUTER_URL

DATABASE_CONN_MAX_AGE=60

# Integrations (→ Secret in k8s)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
FROM_EMAIL=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
MATRIX_HOMESERVER=
MATRIX_TOKEN=

# Scale / disk guard (backend + workers)
SCALE_AUTO_WIPE_BEFORE_BATCH=true
SCALE_BATCH_PARALLEL_CITIES=true
SCALE_BATCH_MAX_PARALLEL_WORKERS=6
SCALE_POSTGRES_DISK_BUDGET_GB=5

# -----------------------------------------------------------------------------
# [celery-worker]  ↔  sport-celery-worker
# -----------------------------------------------------------------------------
CELERY_WORKER_QUEUES=critical,default,notifications
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_MAX_TASKS_PER_CHILD=500
# Share: DATABASE_URL, REDIS_URL, SECRET_KEY, BROUTER_URL from backend references

# -----------------------------------------------------------------------------
# [celery-worker-simulation]  ↔  sport-celery-worker-simulation
# (defaults also in celery-worker-simulation/railway.json)
# -----------------------------------------------------------------------------
CELERY_WORKER_QUEUES=simulation
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=50
SCALE_MAX_STARTS_PER_LIVE_TICK=30
SCALE_SIM_BROUTER_MAX_CALLS_PER_TICK=25
SCALE_SIM_BROUTER_ROUTE_ATTEMPTS=4
SCALE_SIM_STRICT_ROAD_ROUTES=1

# -----------------------------------------------------------------------------
# [brouter]  ↔  sport-brouter  (port 17777, volume /brouter/segments4)
# -----------------------------------------------------------------------------
# No Django env required; ensure other services use BROUTER_URL above.

# -----------------------------------------------------------------------------
# [admin]  ↔  sport-admin (optional manifest admin.optional.yaml)
# -----------------------------------------------------------------------------
# VITE_API_URL=https://api.example.com  (build-time / Railway Variables)

# -----------------------------------------------------------------------------
# K8s-only (not Railway service names — in-cluster DNS)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://sport-redis:6379/0
# CELERY_BROKER_URL=redis://sport-redis:6379/0
# CELERY_RESULT_BACKEND=redis://sport-redis:6379/1
