{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicy": "ALWAYS",
    "limitOverride": {
      "containers": {
        "cpu": 4,
        "memoryBytes": 8589934592
      }
    }
  }
}
