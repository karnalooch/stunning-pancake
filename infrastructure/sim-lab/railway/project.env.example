# Railway sim-lab project — service wiring (names only, no secrets)
#
# Create a NEW Railway project (e.g. 4velo-sim-lab). Link monorepo; per service set:
#   rootDirectory: /
#   railwayConfigFile: see table below
#
# | Service                  | railwayConfigFile                          |
# |--------------------------|--------------------------------------------|
# | backend                  | backend/railway.json                       |
# | admin (optional)         | admin/railway.json                         |
# | celery-worker-simulation | celery-worker-simulation/railway.json      |
# | celery-worker-routing    | celery-worker-routing/railway.json         |
# | celery-worker            | celery-worker/railway.json                 |
# | telemetry                | telemetry/railway.json                     |
# | brouter                  | infrastructure/brouter/railway.json        |
# | osrm (optional)          | infrastructure/osrm/railway.json           |
#
# Plugins (dedicated — do NOT reference prod Postgres/Redis):
#   Postgres (Timescale/PostGIS) — volume >= 30 GB for 300k
#   Redis — volume >= 2 GB for 50k live index
#
# Reference vars on each Django/Celery service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
#   BROUTER_URL=http://brouter.railway.internal:17777/brouter
#   TELEMETRY_URL=http://telemetry.railway.internal:8001
#
# Apply scale profile (from repo root):
#   .\infrastructure\sim-lab\scripts\sync-sim-lab-profile.ps1 -Profile 300k-50k
#
# Script / shell targets (set after first deploy):
SIM_LAB_PROJECT_NAME=4velo-sim-lab
SIM_LAB_PROJECT_ID=
SIM_LAB_ENVIRONMENT=production
SIM_LAB_API_BASE=https://YOUR-backend-sim-lab.up.railway.app/api
SIM_LAB_ADMIN_URL=https://YOUR-admin-sim-lab.up.railway.app
SIM_LAB_TELEMETRY_URL=https://YOUR-telemetry-sim-lab.up.railway.app
