# Sim-lab — load test environment (NOT production)
# Copy: cp infrastructure/sim-lab/.env.sim-lab.example .env.sim-lab
# Local: docker compose --env-file .env.sim-lab -f docker-compose.yml -f infrastructure/sim-lab/docker-compose.sim-lab.yml up -d

# --- Identity ---
SENTRY_ENVIRONMENT=sim-lab
DEBUG=1
SECRET_KEY=sim-lab-insecure-local-only-change-me

POSTGRES_DB=sport_sim
POSTGRES_USER=sport_user
DB_PASSWORD=sim_lab_pass

REDIS_URL=redis://redis:6379/0

# --- API targets (scripts / admin) ---
SIM_LAB_API_BASE=http://localhost:8000/api
SIM_LAB_ADMIN_URL=http://localhost:3001
SIM_LAB_TELEMETRY_URL=http://localhost:8001

# Railway sim-lab project (after deploy — override in shell, never commit secrets)
# SIM_LAB_API_BASE=https://backend-sim-lab.up.railway.app/api
# SIM_LAB_PROJECT_ID=
# SIM_LAB_ENVIRONMENT=production

# --- Scale profile: 300k pool / 50k ACTIVE (see railway/profiles/300k-50k.env) ---
SCALE_MAX_BATCH_USERS=350000
SCALE_MAX_LIVE_POOL=350000
SCALE_MAX_CONCURRENT_RIDERS=50000
SCALE_MAX_TELEMETRY_PUBLISH=50000
SCALE_LIVE_POOL_MAX_REDIS=50000
SCALE_MAX_STARTS_PER_LIVE_TICK=1000
SCALE_OVERRIDE_MAX_STARTS_HARD_CAP=1000
SCALE_SIM_BROUTER_MAX_CALLS_PER_TICK=500
SCALE_OVERRIDE_MAX_BROUTER_CALLS_HARD_CAP=500
SCALE_SIM_BROUTER_ROUTE_ATTEMPTS=4
SCALE_SIM_MAX_PIPELINE_ABSOLUTE=55000
SCALE_POSTGRES_DISK_BUDGET_GB=30
SCALE_AUTO_WIPE_BEFORE_BATCH=true
SCALE_AUTO_DISK_GUARD=true

# Telemetry sharding (load ingest)
TELEMETRY_SHARD_COUNT=4
TELEMETRY_INGEST_BATCH_SIZE=200
TELEMETRY_DB_POOL_MAX=30
GLOBAL_MAX_INGEST_PER_SECOND=60000

# Routing
BROUTER_URL=http://brouter:17777/brouter
OSRM_URL=http://osrm:5000
SCALE_SIM_ROUTING_BACKEND=osrm

# Prod guard — scripts refuse prod URL unless explicitly allowed
# ALLOW_PROD_LOAD_TEST=0
