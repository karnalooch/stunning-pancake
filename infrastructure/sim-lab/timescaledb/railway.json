{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "multiRegionConfig": {
      "europe-west4-drams3a": { "numReplicas": 1 }
    },
    "sleepApplication": false,
    "restartPolicy": "ALWAYS"
  }
}
