{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "celery-worker-simulation/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicy": "ALWAYS"
  },
  "variables": {
    "BROUTER_URL": "http://brouter.railway.internal:17777/brouter",
    "BROUTER_TIMEOUT": "30",
    "SCALE_SIM_STRICT_ROAD_ROUTES": "1",
    "SCALE_SIM_SKIP_BROUTER": "0",
    "CELERY_WORKER_QUEUES": "simulation",
    "CELERY_WORKER_CONCURRENCY": "6"
  }
}
