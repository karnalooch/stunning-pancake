# ===========================================================================
# 4VELO Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# ---------------------------------------------------------------------------
POSTGRES_DB=4velo_db
POSTGRES_USER=4velo_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets_secrets.token_hex_50
DEBUG=0

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# FastAPI Telemetry
# ---------------------------------------------------------------------------
TELEMETRY_URL=http://telemetry:8001

# ---------------------------------------------------------------------------
# Traccar
# ---------------------------------------------------------------------------
TRACCAR_DB_PASSWORD=CHANGE_ME_same_as_DB_PASSWORD

# ---------------------------------------------------------------------------
# Matrix (E2EE Chat)
# ---------------------------------------------------------------------------
MATRIX_HOMESERVER=https://matrix.org
MATRIX_TOKEN=CHANGE_ME_matrix_bot_access_token

# ---------------------------------------------------------------------------
# External AI Services (LLM Coaching + System Intelligence)
# ---------------------------------------------------------------------------
# OpenAI-compatible API key for LLM coaching (AvatarTrainerService)
# and System Intelligence admin dashboard analysis.
OPENAI_API_KEY=sk-CHANGE_ME
# Override LLM API endpoint (default: https://api.openai.com/v1)
LLM_API_URL=
# Override LLM model (default: gpt-4o-mini for mobile, gpt-4o for admin)
# Mobile coach uses gpt-4o-mini for low latency (<500ms P95)
# Admin SysIntelligence uses gpt-4o for deeper analytical capability
LLM_MODEL=
# LLM timeout in milliseconds (default: 5000 for mobile, 15000 for admin)
LLM_TIMEOUT_MS=
# Google AI (Image Generation)
GOOGLE_API_KEY=AIzaSy...-CHANGE_ME
BROUTER_URL=http://brouter:17777/brouter
TRACCAR_URL=http://traccar:8082

# ---------------------------------------------------------------------------
# Stripe (Payments — optional for Milestone 1)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---------------------------------------------------------------------------
# Admin frontend
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_TELEMETRY_WS=ws://localhost:8001/ws/telemetry/live
VITE_TELEMETRY_API=http://localhost:8001/api/telemetry/live

# ---------------------------------------------------------------------------
# Traccar → Redis Direct (Milestone 2 — bypasses HTTP webhooks)
# ---------------------------------------------------------------------------
TRACCAR_REDIS_CHANNEL=traccar:positions

# ---------------------------------------------------------------------------
# Anti-Cheat: Fast Selection Gate (Layer 1) — configurable without redeploy
# ---------------------------------------------------------------------------
# TELEPORT: Max consecutive GPS jump in metres (default: 500m)
GATE_TELEPORT_M=500
# ACCELERATION: Max physiological acceleration in m/s² (default: 6.0 = sprint start)
GATE_MAX_ACCEL=6.0
# MOTOR FINGERPRINT: Max speed coefficient of variation σ/μ (default: 0.05 = 5%)
GATE_MOTOR_VAR=0.05
# STRAIGHT-LINE RATIO: Max displacement/track ratio (default: 0.92 = 92%)
GATE_STRAIGHT_RATIO=0.92
# Minimum segments required for motor fingerprint check (default: 15)
GATE_MOTOR_MIN_SEG=15

# ---------------------------------------------------------------------------
# Anti-Cheat: V-max Kinematic Check (Layer 2)
# ---------------------------------------------------------------------------
VMAX_ANOMALY_RATIO=0.20
VMAX_CONSECUTIVE=3
VMAX_MARGIN=1.10

# ---------------------------------------------------------------------------
# Leaderboard (Redis)
# ---------------------------------------------------------------------------
LEADERBOARD_CACHE_TTL=30

# ---------------------------------------------------------------------------
# Observability: Sentry (Milestone 3)
# ---------------------------------------------------------------------------
# Leave SENTRY_DSN empty to disable Sentry (default for local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
# Backend: percentage of requests profiled (0.0-1.0, recommended: 0.1 in prod)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Privacy Zones v2 (Milestone 3)
# ---------------------------------------------------------------------------
# Density boost threshold: expand zone radius if N+ users share a nearby zone
PRIVACY_DENSITY_BOOST_THRESHOLD=3
# Density boost multiplier (e.g. 1.5 = 50% larger radius)
PRIVACY_DENSITY_BOOST_FACTOR=1.5

# ---------------------------------------------------------------------------
# Matrix E2EE Chat
# ---------------------------------------------------------------------------
MATRIX_HOMESERVER=https://matrix.org
# Bot account access token — leave empty to enable dev/placeholder mode
MATRIX_TOKEN=

# ---------------------------------------------------------------------------
# Milestone 4: Stripe (Payments & Subscriptions)
# ---------------------------------------------------------------------------
# sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard (Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products
STRIPE_B2C_PRICE_ID=
STRIPE_B2B_PRICE_ID=

# ---------------------------------------------------------------------------
# Milestone 4: Rewards & Points
# ---------------------------------------------------------------------------
# Points awarded per verified kilometre
REWARDS_POINTS_PER_KM=10

# ---------------------------------------------------------------------------
# Milestone 4: Multi-Tenancy (PostgreSQL RLS)
# ---------------------------------------------------------------------------
# DB role used by Django in production (must have BYPASSRLS on superuser)
RLS_APP_ROLE=4velo_app

# ---------------------------------------------------------------------------
# Milestone 5: ML Anti-Cheat & Analytics
# ---------------------------------------------------------------------------
# Path to trained IsolationForest model file (pickle)
ML_MODEL_PATH=/app/models/anomaly_detector.pkl
# Anomaly threshold: score below this = anomalous (-1 to 0 scale)
ML_ANOMALY_THRESHOLD=-0.15

# ---------------------------------------------------------------------------
# Hyperscale: Redis Cluster (docker-compose.scale.yml)
# ---------------------------------------------------------------------------
# Leave empty to use single REDIS_URL (dev/staging)
# Set to comma-separated host:port list to enable cluster mode
# Example: redis-master-1:6379,redis-master-2:6380,redis-master-3:6381
REDIS_CLUSTER_NODES=

# ---------------------------------------------------------------------------
# Hyperscale: Citus PostgreSQL Sharding
# ---------------------------------------------------------------------------
# Shard count: 2× worker count recommended (3 workers → 32 shards)
CITUS_SHARD_COUNT=32
# Worker nodes (comma-separated host:port) — registered via add_citus_worker()
# CITUS_WORKER_NODES=db-worker-1:5432,db-worker-2:5432,db-worker-3:5432

# ---------------------------------------------------------------------------
# RC v0.2: SendGrid (Transactional Email)
# ---------------------------------------------------------------------------
# API key from sendgrid.com → Settings → API Keys → Create
SENDGRID_API_KEY=
# Sender email — must be verified in SendGrid
FROM_EMAIL=no-reply@4velo.app
FROM_NAME=4VELO Platform

# ---------------------------------------------------------------------------
# RC v0.2: Strava OAuth Integration
# ---------------------------------------------------------------------------
# From strava.com/settings/api → Create Application
# Redirect URI: https://your-domain.com/api/activities/wearables/strava/callback/
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://sport-platform.com/api/activities/wearables/strava/callback/

# ---------------------------------------------------------------------------
# RC v0.2: Garmin OAuth Integration
# ---------------------------------------------------------------------------
# From developer.garmin.com → Create Application
# Redirect URI: https://your-domain.com/api/activities/wearables/garmin/callback/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://sport-platform.com/api/activities/wearables/garmin/callback/
