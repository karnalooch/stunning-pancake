# ===========================================================================
# 4VELO Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://4velo_user:CHANGE_ME@localhost:5432/4velo_db
# Legacy per-component DB config (replaced by DATABASE_URL above):
# POSTGRES_DB=4velo_db
# POSTGRES_USER=4velo_user
# DB_PASSWORD=CHANGE_ME_strong_password_here

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets_secrets.token_hex_50
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed for cross-origin API calls (merged with defaults in settings.py).
# Production admin Railway URL is already in code defaults; set this when adding staging/custom domains.
# CORS_ALLOWED_ORIGINS=https://my-staging-admin.example.com
# CSRF_TRUSTED_ORIGINS=  # optional extra origins; defaults mirror CORS_ALLOWED_ORIGINS
TOKEN_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REDIS_URL with embedded credentials (standard):
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD — alternative for managed services (Railway, Render, etc.)
# that provide password as a separate env var. If set, it's auto-injected
# into REDIS_URL/CELERY_BROKER_URL at connection time.
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Scale / load test (300k athletes) — see docs/SCALE_TEST_300K.md
# ---------------------------------------------------------------------------
# SCALE_MAX_BATCH_USERS=350000
# SCALE_MAX_LIVE_POOL=350000
# SCALE_MAX_CONCURRENT_RIDERS=50000
# SCALE_MAX_TELEMETRY_PUBLISH=50000
# SCALE_TELEMETRY_API_LIMIT=800
# SCALE_TELEMETRY_API_MAX_LIMIT=15000
# SCALE_FORCE_SKIP_ACTIVITIES_ABOVE=150000
# SCALE_STATS_CACHE_TTL=120
# SCALE_HEATMAP_MAX_BBOX_KM=120
# SCALE_HEATMAP_MAX_ACTIVITIES=1500
# SCALE_HEATMAP_MIN_ZOOM=7
# SCALE_WIPE_CHUNK_SIZE=1000        # General wipe batches (activities, tenants, …)
# SCALE_WIPE_USER_CHUNK_SIZE=200    # User phase — smaller to avoid celery-worker OOM
# Railway Hobby: per-service RAM caps in */railway.json (SSOT). Prod targets ~12 GB sum
#   (celery-worker 2G, simulation 4G, routing 2×1G, backend/telemetry/brouter 1G each).
#   Replica max 8 GB; do not raise CELERY_WORKER_CONCURRENCY on wipe worker without more RAM.
# SCALE_AUTO_DISK_GUARD=true
# SCALE_DISK_MONITOR_ENABLED=true
# SCALE_POSTGRES_DISK_BUDGET_GB=5   # Railway: set on backend + celery-worker + celery-worker-simulation
# WIPE_USE_BACKEND_THREAD=1         # Optional: run wipe on API process if default Celery queue has no worker
# WIPE_ALWAYS_THREAD=1              # Same as WIPE_USE_BACKEND_THREAD (alias for Railway wipe-only)
# WIPE_STALE_QUEUED_SEC=120         # queued/starting with no worker pickup → stuck
# WIPE_STALE_NO_PROGRESS_SEC=180    # running but no Redis progress touch → stuck
# WIPE_STALE_RUNNING_SEC=900        # fallback when last_progress_at missing (legacy state)
# WIPE_STALE_USERS_SEC=300          # users phase: max(NO_PROGRESS, this) for stuck threshold
# SCALE_SIM_CITY_START_RADIUS_KM=4    # Live sim: spread riders near city center (see docs/operations/SIMULATOR.md)
# SCALE_SIM_BROUTER_START_RADIUS_KM=4 # BRouter route attempts jitter from center
# SCALE_SIM_BROUTER_ROUTE_ATTEMPTS=4
# SCALE_MAX_STARTS_PER_LIVE_TICK=30
# SCALE_SIM_BROUTER_MAX_CALLS_PER_TICK=25
# Live sim routing backpressure (async route_live_ride_task on celery-worker-routing)
# SCALE_SIM_ASYNC_ROUTING=1
# SCALE_SIM_MAX_ROUTING_QUEUE_DEPTH=200   # turbo: 3× routing; lower if BP too often
# SCALE_SIM_MAX_ROUTING_DISPATCH_PER_TICK=150  # match SCALE_MAX_STARTS_PER_LIVE_TICK at load=100
# SCALE_MAX_STARTS_PER_LIVE_TICK=150      # floor when session has no scale_overrides
# SIM_AUTO_LOWER_ACTIVE_RATIO_ON_BP=0     # default off — operator sliders stay authoritative
# SIM_BP_LOWER_AFTER_TICKS=12             # when auto-lower enabled
# SIM_BP_LOWER_FACTOR=0.95
# SIM_BP_MIN_DISPATCH_PER_TICK=12         # floor dispatches/tick during backpressure (never stall)
# SIM_BP_DRAIN_DISPATCH_PER_TICK=20
# SIM_BP_QUEUE_HEADROOM=25                # depth above cap before min-dispatch floor
# SCALE_SIM_RAMP_START_DELAY_MAX=20       # first N ticks: start_delay 0..this (else 0..90)
# SCALE_SIM_RAMP_TICKS=12                 # ramp window = ramp_ticks * tick_seconds
# CELERY_WORKER_POOL=solo          # celery-worker-simulation on Railway (low memory)
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# CELERY_MAX_TASKS_PER_CHILD=50
# SCALE_SIM_STRICT_ROAD_ROUTES=1    # Live sim: require road-routable paths (skip starts if BRouter unavailable)
# SCALE_DISK_WARN_PCT=0.80
# SCALE_DISK_PAUSE_SIM_PCT=0.90
# SCALE_DISK_BLOCK_WRITES_PCT=0.95
# SCALE_SIM_ACTIVITY_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Global always-on protection (platform-wide, independent of any event)
# See docs/EVENT_BURST_50K.md "Always-on global protection"
# ---------------------------------------------------------------------------
# GLOBAL_PROTECTION_MODE=auto          # auto (default) | on (always enforce) | off
# GLOBAL_MAX_JOIN_PER_MINUTE=8000
# GLOBAL_MAX_SESSION_PER_MINUTE=5000
# GLOBAL_MAX_INGEST_PER_SECOND=20000   # telemetry ingest cap (FastAPI + sim signal)
# GLOBAL_MAX_CONCURRENT_RIDERS=50000
# GLOBAL_PROTECTION_ENGAGE_RATIO=0.9   # auto: engage at 90% of cap (hysteresis 120s)

# ---------------------------------------------------------------------------
# FastAPI Telemetry
# ---------------------------------------------------------------------------
TELEMETRY_URL=http://telemetry:8001
# Horizontal sharding of the live-position index — see docs/operations/TELEMETRY_SHARDING.md
# TELEMETRY_SHARD_COUNT=1              # 1 (default) = legacy single key; >1 = N shards (hash-tagged)
# REDIS_TELEMETRY_SHARD_NODES=         # Phase 2: comma-separated Redis URLs per shard (logical DBs or dedicated instances)
# TELEMETRY_SHARD_READ_WORKERS=8       # parallel GEORADIUS fan-out (default min(shards, 8))
# FastAPI telemetry ingest (TimescaleDB pool + batching)
# TELEMETRY_DB_POOL_MIN=5
# TELEMETRY_DB_POOL_MAX=30
# TELEMETRY_INGEST_BATCH_SIZE=100
# TELEMETRY_INGEST_FLUSH_MS=50
# TELEMETRY_SKIP_DB=0              # 1 = ingest guard+dedupe only, skip TimescaleDB insert (throughput bench)
# TELEMETRY_SKIP_BROADCAST=0       # 1 = skip WebSocket position_update broadcast
# UVICORN_WORKERS=1                # telemetry Dockerfile only; >1 for multi-process ingest bench

# ---------------------------------------------------------------------------
# Traccar
# ---------------------------------------------------------------------------
TRACCAR_USER=admin
TRACCAR_PASS=CHANGE_ME

# ---------------------------------------------------------------------------
# Matrix (E2EE Chat)
# ---------------------------------------------------------------------------
MATRIX_HOMESERVER=https://matrix.org
MATRIX_TOKEN=CHANGE_ME_matrix_bot_access_token

# ---------------------------------------------------------------------------
# External AI Services (LLM Coaching + System Intelligence)
# ---------------------------------------------------------------------------
# OpenAI-compatible API key for LLM coaching (AvatarTrainerService)
OPENAI_API_KEY=sk-CHANGE_ME
# Override LLM API endpoint (default: https://api.openai.com/v1)
LLM_API_URL=
# Override LLM model (default: gpt-4o-mini for mobile, gpt-4o for admin)
LLM_MODEL=
# LLM timeout in milliseconds (default: 5000 for mobile, 15000 for admin)
LLM_TIMEOUT_MS=
# DeepSeek API (alternative AI provider)
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_MODEL=deepseek-chat
# Google Gemini API (fallback + image generation)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_IMAGEN=false
GOOGLE_API_KEY=AIzaSy...-CHANGE_ME
BROUTER_URL=http://brouter:17777/brouter
# Railway private DNS: http://brouter.railway.internal:17777/brouter
BROUTER_TIMEOUT=30
# BROUTER_RETRIES=3   # RemoteDisconnected / 5xx retries (HTTP connection pool)
# SCALE_SIM_BROUTER_ROUTE_ATTEMPTS=8
# SCALE_SIM_BROUTER_MAX_LEG_KM=4   # Max A→B km per BRouter request (live sim road shape)
TRACCAR_URL=http://traccar:8082

# ---------------------------------------------------------------------------
# Social Login (OAuth2)
# ---------------------------------------------------------------------------
# Google OAuth2 Web Application credentials
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_SECRET=GOCSPX-CHANGE_ME
# Must match Google Cloud Console — backend callback URL (not frontend hash route)
GOOGLE_REDIRECT_URI=https://backend-production-55c7.up.railway.app/api/auth/google/callback/
# Facebook OAuth2 App credentials
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_SECRET=CHANGE_ME
FACEBOOK_REDIRECT_URI=https://backend-production-55c7.up.railway.app/api/auth/facebook/callback/
# OAuth state token TTL in seconds
OAUTH_STATE_TTL=600
# Frontend base URL (admin panel — JWT appended to #/auth/callback)
FRONTEND_URL=https://admin-production-083b.up.railway.app
# Mobile deep link after OAuth (scheme must match mobile/app.config.js)
MOBILE_DEEP_LINK_SCHEME=fourvelo
# Default tenant assigned to new mobile OAuth registrations
DEFAULT_OAUTH_TENANT_ID=siedlce-city
# Comma-separated emails auto-promoted to GLOBAL_OWNER on OAuth login
GLOBAL_OWNER_EMAILS=admin@4velo.app

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Redis password — required for managed Redis (Railway, Render, Upstash)
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
DEPARTMENTS_ENABLED=true

# ---------------------------------------------------------------------------
# Django Superuser (initial setup)
# ---------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@4velo.app
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Global Owner Account
# ---------------------------------------------------------------------------
GLOBAL_OWNER_USERNAME=global_owner
GLOBAL_OWNER_EMAIL=owner@4velo.app
GLOBAL_OWNER_PASSWORD=CHANGE_ME
GLOBAL_OWNER_EMAILS=owner@4velo.app

# ---------------------------------------------------------------------------
# Admin Account (fallback)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@4velo.app
ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# True to enable Department organizational hierarchy feature
# ---------------------------------------------------------------------------
# Mobile App (Expo)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.4velo.app
EXPO_PUBLIC_TELEMETRY_URL=https://telemetry.4velo.app
EXPO_PUBLIC_LLM_API_URL=https://api.openai.com/v1
EXPO_PUBLIC_LLM_API_KEY=sk-CHANGE_ME
EXPO_PUBLIC_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Stripe (Payments — optional for Milestone 1)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_B2C_PRICE_ID=
STRIPE_B2B_PRICE_ID=

# ---------------------------------------------------------------------------
# Admin frontend
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
# MapLibre basemap (OpenFreeMap defaults; see docs/compliance/MAP_BASEMAP_LICENSING.md)
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_URL_LIGHT=   # LiveMap override
# VITE_MAP_STYLE_URL_DARK=    # GlobalHeatmap override

# ---------------------------------------------------------------------------
# Traccar → Redis Direct (Milestone 2 — bypasses HTTP webhooks)
# ---------------------------------------------------------------------------
TRACCAR_REDIS_CHANNEL=traccar:positions

# ---------------------------------------------------------------------------
# Anti-Cheat: Fast Selection Gate (Layer 1) — configurable without redeploy
# ---------------------------------------------------------------------------
# TELEPORT: Max consecutive GPS jump in metres (default: 500m)
GATE_TELEPORT_M=500
# ACCELERATION: Max physiological acceleration in m/s² (default: 6.0 = sprint start)
GATE_MAX_ACCEL=6.0
# MOTOR FINGERPRINT: Max speed coefficient of variation σ/μ (default: 0.05 = 5%)
GATE_MOTOR_VAR=0.05
# STRAIGHT-LINE RATIO: Max displacement/track ratio (default: 0.92 = 92%)
GATE_STRAIGHT_RATIO=0.92
# Minimum segments required for motor fingerprint check (default: 15)
GATE_MOTOR_MIN_SEG=15

# ---------------------------------------------------------------------------
# Anti-Cheat: V-max Kinematic Check (Layer 2)
# ---------------------------------------------------------------------------
VMAX_ANOMALY_RATIO=0.20
VMAX_CONSECUTIVE=3
VMAX_MARGIN=1.10

# ---------------------------------------------------------------------------
# Leaderboard (Redis)
# ---------------------------------------------------------------------------
LEADERBOARD_CACHE_TTL=30

# ---------------------------------------------------------------------------
# Observability: Sentry (Milestone 3)
# ---------------------------------------------------------------------------
# Leave SENTRY_DSN empty to disable Sentry (default for local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
# Backend: percentage of requests profiled (0.0-1.0, recommended: 0.1 in prod)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Privacy Zones v2 (Milestone 3)
# ---------------------------------------------------------------------------
# Density boost threshold: expand zone radius if N+ users share a nearby zone
# Density boost multiplier (e.g. 1.5 = 50% larger radius)

# ---------------------------------------------------------------------------
# Matrix E2EE Chat
# ---------------------------------------------------------------------------
MATRIX_HOMESERVER=https://matrix.org
# Bot account access token — leave empty to enable dev/placeholder mode
MATRIX_TOKEN=

# ---------------------------------------------------------------------------
# Milestone 4: Stripe (Payments & Subscriptions)
# ---------------------------------------------------------------------------
# sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard (Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products
STRIPE_B2C_PRICE_ID=
STRIPE_B2B_PRICE_ID=

# ---------------------------------------------------------------------------
# Milestone 4: Rewards & Points
# ---------------------------------------------------------------------------
# Points awarded per verified kilometre

# ---------------------------------------------------------------------------
# Milestone 4: Multi-Tenancy (PostgreSQL RLS)
# ---------------------------------------------------------------------------
# DB role used by Django in production (must have BYPASSRLS on superuser)

# ---------------------------------------------------------------------------
# Milestone 5: ML Anti-Cheat & Analytics
# ---------------------------------------------------------------------------
# Path to trained IsolationForest model file (pickle)
ML_MODEL_PATH=/app/models/anomaly_detector.pkl
# Anomaly threshold: score below this = anomalous (-1 to 0 scale)
ML_ANOMALY_THRESHOLD=-0.15
# ML Retraining config
ML_RETRAIN_LOOKBACK_DAYS=90
ML_RETRAIN_MIN_SAMPLES=1000

# ---------------------------------------------------------------------------
# Hyperscale: Redis Cluster (docker-compose.scale.yml)
# ---------------------------------------------------------------------------
# Leave empty to use single REDIS_URL (dev/staging)
# Set to comma-separated host:port list to enable cluster mode
# Example: redis-master-1:6379,redis-master-2:6380,redis-master-3:6381
REDIS_CLUSTER_NODES=

# ---------------------------------------------------------------------------
# Hyperscale: Citus PostgreSQL Sharding
# ---------------------------------------------------------------------------
# Shard count: 2× worker count recommended (3 workers → 32 shards)
# Worker nodes (comma-separated host:port) — registered via add_citus_worker()
# CITUS_WORKER_NODES=db-worker-1:5432,db-worker-2:5432,db-worker-3:5432

# ---------------------------------------------------------------------------
# RC v0.2: SendGrid (Transactional Email)
# ---------------------------------------------------------------------------
# API key from sendgrid.com → Settings → API Keys → Create
SENDGRID_API_KEY=
# Sender email — must be verified in SendGrid
FROM_EMAIL=no-reply@4velo.app
FROM_NAME=4VELO Platform

# ---------------------------------------------------------------------------
# RC v0.2: Strava OAuth Integration
# ---------------------------------------------------------------------------
# From strava.com/settings/api → Create Application
# Redirect URI: https://your-domain.com/api/activities/wearables/strava/callback/
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://sport-platform.com/api/activities/wearables/strava/callback/

# ---------------------------------------------------------------------------
# RC v0.2: Garmin OAuth Integration
# ---------------------------------------------------------------------------
# From developer.garmin.com → Create Application
# Redirect URI: https://your-domain.com/api/activities/wearables/garmin/callback/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://sport-platform.com/api/activities/wearables/garmin/callback/

