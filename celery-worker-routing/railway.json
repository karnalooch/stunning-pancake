{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "celery-worker-simulation/Dockerfile"
  },
  "deploy": {
    "numReplicas": 2,
    "sleepApplication": false,
    "restartPolicy": "ALWAYS",
    "limitOverride": {
      "containers": {
        "cpu": 0.5,
        "memoryBytes": 1073741824
      }
    }
  },
  "variables": {
    "BROUTER_URL": "http://brouter.railway.internal:17777/brouter",
    "BROUTER_TIMEOUT": "30",
    "SCALE_SIM_STRICT_ROAD_ROUTES": "1",
    "CELERY_WORKER_QUEUES": "routing",
    "CELERY_WORKER_CONCURRENCY": "2",
    "CELERY_WORKER_POOL": "solo",
    "CELERY_WORKER_PREFETCH_MULTIPLIER": "1",
    "CELERY_MAX_TASKS_PER_CHILD": "50",
    "CELERY_WORKER_HOSTNAME": "routing@%h",
    "SCALE_SIM_ASYNC_ROUTING": "1",
    "SCALE_SIM_MAX_ROUTING_QUEUE_DEPTH": "120",
    "SIM_BP_MIN_DISPATCH_PER_TICK": "12",
    "SIM_BP_DRAIN_DISPATCH_PER_TICK": "20",
    "SIM_BP_QUEUE_HEADROOM": "25",
    "BROUTER_RETRIES": "3"
  }
}
