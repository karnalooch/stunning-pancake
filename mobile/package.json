{
  "name": "4velo",
  "version": "1.0.0",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "eas build --platform android --profile development",
    "ios": "eas build --platform ios --profile development",
    "web": "expo start --web",
    "deploy:mobile": "npx eas update --branch production --message \"Update via Antigravity\"",
    "build:dev:android": "npx eas build --platform android --profile development",
    "build:dev:ios": "npx eas build --platform ios --profile development",
    "build:preview:android": "npx eas build --platform android --profile preview",
    "build:local:preview:android": "npx expo prebuild --clean -p android && cd android && .\\gradlew.bat assembleRelease",
    "build:preview:ios": "npx eas build --platform ios --profile preview",
    "build:prod:android": "npx eas build --platform android --profile production",
    "build:prod:ios": "npx eas build --platform ios --profile production",
    "lint": "expo lint",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-mobile-e2e.ps1",
    "test:e2e:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-mobile-e2e.ps1 -Flow auth-login.yaml",
    "install:maestro": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/install-maestro.ps1",
    "eas-build-pre-install": "bash eas-build-pre-install.sh"
  },
  "dependencies": {
    "@4velo/api-client": "workspace:*",
    "@4velo/tokens": "workspace:*",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/config-plugins": "~55.0.0",
    "@legendapp/state": "3.0.0-beta.46",
    "@maplibre/maplibre-react-native": "^11.0.2",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-firebase/app": "^21.10.0",
    "@react-native-firebase/crashlytics": "^21.10.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@shopify/react-native-skia": "2.4.18",
    "axios": "^1.16.1",
    "eslint-config-expo": "~55.0.1",
    "expo": "^55.0.0",
    "expo-audio": "~55.0.14",
    "expo-av": "^16.0.8",
    "expo-file-system": "~55.0.0",
    "expo-font": "^55.0.6",
    "expo-haptics": "^55.0.14",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.20",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "^56.0.17",
    "expo-speech": "~55.0.14",
    "expo-status-bar": "~55.0.5",
    "expo-task-manager": "~55.0.15",
    "expo-updates": "~55.0.21",
    "lucide-react-native": "^1.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-unistyles": "^3.2.4",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@4velo/tsconfig": "workspace:*",
    "@expo/ngrok": "^4.1.3",
    "@react-native/metro-config": "0.85.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.0",
    "metro-config": "0.84.3",
    "react-native-svg-transformer": "^1.5.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "node-forge": "1.4.0",
    "tar": "7.5.13",
    "yaml": "2.8.3",
    "uuid": "14.0.0",
    "ajv": "8.20.0",
    "eslint": {
      "ajv": "6.15.0"
    },
    "@eslint/eslintrc": {
      "ajv": "6.15.0"
    },
    "eslint-plugin-expo": {
      "ajv": "6.15.0",
      "eslint": {
        "ajv": "6.15.0"
      },
      "@eslint/eslintrc": {
        "ajv": "6.15.0"
      }
    },
    "postcss": "8.5.12",
    "@xmldom/xmldom": ">=0.8.14",
    "minimatch": ">=10.0.1",
    "diff": ">=7.0.0"
  },
  "private": true
}
