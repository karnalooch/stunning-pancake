    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "esbuild": "0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-native-svg-transformer": "^1.5.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "babel-preset-expo": "55.0.25"
  },
  "overrides": {
