    "@react-navigation/native-stack": "^7.17.3",
    "@shopify/react-native-skia": "2.4.18",
    "axios": "^1.20.0",
    "expo": "~55.0.31",
    "expo-audio": "~55.0.18",
    "expo-battery": "~55.0.17",
