{
  "name": "4velo",
  "version": "0.3.4-dev",
  "main": "index",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "pnpm dlx eas-cli@24.7.0 build --platform android --profile development",
    "ios": "pnpm dlx eas-cli@24.7.0 build --platform ios --profile development",
    "web": "expo start --web",
    "deploy:mobile": "pnpm dlx cross-env@7.0.3 EAS_BUILD_PROFILE=production pnpm dlx eas-cli@24.7.0 update --channel production --environment production --clear-cache --message \"Update via 4VELO release tooling\"",
    "build:dev:android": "pnpm dlx eas-cli@24.7.0 build --platform android --profile development",
    "build:dev:ios": "pnpm dlx eas-cli@24.7.0 build --platform ios --profile development",
    "build:preview:android": "pnpm dlx eas-cli@24.7.0 build --platform android --profile preview",
    "build:diagnostic:android:windows": "pnpm exec expo prebuild --clean -p android && cd android && .\\\\gradlew.bat assembleDebug --no-daemon",
    "build:local:preview:android": "pnpm run build:diagnostic:android:windows",
    "build:preview:ios": "pnpm dlx eas-cli@24.7.0 build --platform ios --profile preview",
    "build:prod:android": "pnpm dlx eas-cli@24.7.0 build --platform android --profile production",
    "build:prod:ios": "pnpm dlx eas-cli@24.7.0 build --platform ios --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-mobile-e2e.ps1",
    "test:e2e:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-mobile-e2e.ps1 -Flow auth-login.yaml",
    "install:maestro": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/install-maestro.ps1",
    "start:dev-client": "expo start --dev-client",
    "build:pilot-local:android": "pnpm dlx eas-cli@24.7.0 build --platform android --profile pilot-local",
    "doctor": "pnpm dlx expo-doctor@1.20.4 .",
    "deps:check": "expo install --check"
  },
  "dependencies": {
    "@4velo/api-client": "workspace:*",
    "@babel/runtime": "7.29.7",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
