{
  "cli": {
    "version": "24.7.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "pilot-local": {
      "node": "24.21.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "pilot-local",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_TELEMETRY_URL": "http://localhost:8001",
        "EXPO_PUBLIC_ENABLE_FIREBASE": "false",
        "EXPO_PUBLIC_TELEMETRY_WS_INGEST": "false"
      },
      "environment": "development"
    },
    "development": {
      "node": "24.21.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENABLE_FIREBASE": "false"
      }
    },
    "preview": {
      "node": "24.21.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_FIREBASE": "false"
      }
    },
    "production": {
      "node": "24.21.0",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_FIREBASE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
