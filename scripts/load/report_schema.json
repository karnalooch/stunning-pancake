{
  "$id": "sport-load-report-v1",
  "title": "SPORT load test report",
  "schema_version": "1",
  "required": [
    "schema_version",
    "suite",
    "tier",
    "started_at",
    "finished_at",
    "environment",
    "tools",
    "metrics",
    "threshold_evaluation"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "suite": { "type": "string" },
    "tier": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "environment": {
      "type": "object",
      "properties": {
        "target": { "type": "string" },
        "ingest_url": { "type": "string" },
        "map_url": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "duration_s": { "type": "number" },
          "skipped": { "type": "boolean" },
          "error": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "ingest": {
          "type": "object",
          "properties": {
            "positions_per_second": { "type": "number" },
            "requests_per_second": { "type": "number" },
            "latency_ms": { "type": "object" },
            "accepted": { "type": "integer" },
            "throttled": { "type": "integer" },
            "errors": { "type": "integer" },
            "error_rate": { "type": "number" }
          }
        },
        "map": {
          "type": "object",
          "properties": {
            "latency_ms": { "type": "object" },
            "ok": { "type": "integer" },
            "errors": { "type": "integer" },
            "error_rate": { "type": "number" }
          }
        }
      }
    },
    "threshold_evaluation": {
      "type": "object",
      "required": ["tier", "pass"],
      "properties": {
        "tier": { "type": "string" },
        "pass": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "pass"],
            "properties": {
              "name": { "type": "string" },
              "pass": { "type": "boolean" },
              "expected": {},
              "actual": {},
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "properties": {
        "pass": { "type": "boolean" },
        "checks": { "type": "array" }
      }
    },
    "merged_from": { "type": "array", "items": { "type": "string" } }
  }
}
