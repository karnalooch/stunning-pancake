{
  "name": "smoke",
  "tier": "smoke",
  "description": "Quick sanity check against local Docker Compose",
  "preflight": true,
  "environment": {
    "target": "local-docker",
    "ingest_url": "http://localhost:8001/api/telemetry/ingest/batch",
    "map_url": "http://localhost:8000/api/activities/telemetry/live/"
  },
  "steps": [
    {
      "tool": "python-ingest",
      "params": {
        "workers": 5,
        "duration": 10,
        "batch_size": 20,
        "target_rate": 0,
        "skip_map": true,
        "preflight": true
      }
    }
  ]
}
