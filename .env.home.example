# Generated safely by: python scripts/home_lab.py init
# This template contains no usable credentials. .env.home is ignored by Git.
POSTGRES_DB=4velo_home
POSTGRES_USER=4velo_home
DB_PASSWORD=GENERATE_WITH_HOME_LAB_INIT
# T73: runtime services use a separate NOSUPERUSER/NOBYPASSRLS login.
# The isolated lab reuses the generated local DB password for this second login;
# privilege separation comes from the PostgreSQL role, not from secret reuse.
APP_DB_USER=4velo_runtime
RLS_RUNTIME_ROLE_GUARD=1
SECRET_KEY=GENERATE_WITH_HOME_LAB_INIT
TELEMETRY_INGEST_JWT_SECRET=GENERATE_WITH_HOME_LAB_INIT
# T75: generated locally and never committed or written to recovery evidence.
BACKUP_ENCRYPTION_KEY=GENERATE_WITH_HOME_LAB_INIT
# P3 pilot data-safety contract: auth/scope required and ACK only after direct DB persistence.
TELEMETRY_INGEST_JWT_REQUIRED=1
TELEMETRY_INGEST_AUDIENCE_REQUIRED=1
TELEMETRY_INGEST_QUEUE=0
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
REDIS_URL=redis://redis:6379/0
VITE_API_URL=http://localhost:8000/api
RUN_DEMO_SEED=0
