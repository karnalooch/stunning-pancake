{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "admin/Dockerfile"
  },
  "deploy": {
    "multiRegionConfig": {
      "europe-west4-drams3a": { "numReplicas": 1 }
    },
    "sleepApplication": false,
    "restartPolicy": "ALWAYS",
    "limitOverride": {
      "containers": {
        "cpu": 0.5,
        "memoryBytes": 536870912
      }
    }
  }
}
