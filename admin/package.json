{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live-map": "cross-env E2E_FORCE_WEB_SERVER=1 playwright test e2e/live-map-zoom.spec.ts --project=live-map-zoom",
    "test:e2e:live-map:update": "cross-env E2E_FORCE_WEB_SERVER=1 playwright test e2e/live-map-zoom.spec.ts --project=live-map-zoom --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "licenses:report": "node ../scripts/compliance/generate-third-party-notices.mjs",
    "electron:dev": "concurrently \"vite\" \"cross-env NODE_ENV=development wait-on http://localhost:5173 && electron .\"",
    "build:exe": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@4velo/api-client": "workspace:*",
    "@4velo/tokens": "workspace:*",
    "@mantine/core": "^9.1.0",
    "@mantine/form": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@mantine/notifications": "^9.1.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.5",
    "axios": "^1.16.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.47.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@4velo/eslint-config": "workspace:*",
    "@4velo/tsconfig": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.fourvelo.owner",
    "productName": "4VELO Owner OS",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "asar": true,
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  }
}
