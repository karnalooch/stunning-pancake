{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "celery-worker/Dockerfile"
    },
    "deploy": {
        "numReplicas": 1,
        "sleepApplication": false,
        "restartPolicy": "ALWAYS",
        "limitOverride": {
            "containers": {
                "cpu": 0.5,
                "memoryBytes": 1073741824
            }
        }
    }
}