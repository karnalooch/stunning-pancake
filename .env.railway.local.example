# Local Railway CLI / verification (copy to .env.railway.local — gitignored)
# Do NOT commit real tokens or production secrets.

# Windows User env (recommended for Cursor agent): set RAILWAY_API_TOKEN once in
# System Properties → Environment Variables → User variables.
# PowerShell: [Environment]::SetEnvironmentVariable('RAILWAY_API_TOKEN','<token>','User')
# Remove legacy RAILWAY_TOKEN if present; CLI prefers RAILWAY_API_TOKEN.

RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=ce13089b-76f4-4114-a892-ad13e23c8761
RAILWAY_ENVIRONMENT=production

# Optional: default service when running `railway variable list` without -s
# RAILWAY_SERVICE=celery-worker-simulation
