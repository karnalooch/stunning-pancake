{
  "name": "4velo",
  "version": "0.1.0-beta.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "tokens:build": "pnpm --filter @4velo/tokens build",
    "tokens:check": "pnpm --filter @4velo/tokens check",
    "api:export": "python scripts/export_openapi.py",
    "api:codegen:check": "pnpm --filter @4velo/api-client codegen:check",
    "quality:baseline": "pwsh -File scripts/run-quality-baseline.ps1",
    "audit:routes": "tsx scripts/audit-routes.ts",
    "audit:screens": "tsx scripts/audit-screens.ts",
    "audit:mobile": "tsx scripts/audit-mobile-routes.ts",
    "audit:api": "tsx scripts/audit-api-gaps.ts",
    "audit:rbac": "tsx scripts/audit-rbac.ts",
    "audit:redirects": "tsx scripts/audit-redirects.ts",
    "audit:env": "tsx scripts/audit-env.ts",
    "audit:imports": "tsx scripts/audit-dead-imports.ts",
    "audit:orm": "tsx scripts/audit-orm-performance.ts",
    "audit:async": "tsx scripts/audit-async-race-conditions.ts",
    "audit:compat": "tsx scripts/audit-env-compatibility.ts",
    "audit:maplibre": "tsx scripts/audit-maplibre-imports.ts",
    "audit:simulator": "tsx scripts/audit-simulator.ts",
    "audit:auth": "tsx scripts/audit-auth-session.ts",
    "audit:security": "tsx scripts/audit-security.ts",
    "audit:secrets": "tsx scripts/audit-secrets.ts",
    "audit:sca": "tsx scripts/audit-sca.ts",
    "audit:platform": "tsx scripts/audit-all.ts",
    "audit:platform:quick": "tsx scripts/audit-all.ts --quick",
    "audit:all": "pnpm audit:auth && pnpm audit:platform:quick && pnpm audit:routes && pnpm audit:screens && pnpm audit:mobile && pnpm audit:api && pnpm audit:rbac && pnpm audit:redirects && pnpm audit:env && pnpm audit:imports && pnpm audit:orm && pnpm audit:async && pnpm audit:compat && pnpm audit:maplibre && pnpm audit:simulator",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:admin": "pnpm --filter admin test:run",
    "build": "turbo run build"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  }
}
